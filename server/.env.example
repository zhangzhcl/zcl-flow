# ===========================================
# ZCL Flow Server Environment Configuration
# Copy this file to .env and adjust the values
# ===========================================

# Server port
PORT=3001

# Allowed CORS origin(s), comma-separated (client dev server may move to the
# next free port, e.g. 5173 -> 5174, so list them all)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# SQLite database file path (relative to server root)
DATABASE_PATH=data/zcl-flow.sqlite

# ------- Authentication -------
# Secret used to sign JWT access tokens. CHANGE THIS IN PRODUCTION.
JWT_SECRET=zcl-flow-dev-secret-change-me
# Token lifetime (e.g. 60s, 12h, 7d)
JWT_EXPIRES_IN=7d
# Bootstrap administrator, created on first start only.
ADMIN_USERNAME=admin
# Leave empty to have a strong password generated and printed in the server log.
ADMIN_PASSWORD=admin123

# ------- LLM Provider (OpenAI-compatible API) -------
# Leave LLM_API_KEY empty to use the built-in mock responder,
# which keeps the full workflow loop runnable without any key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
# LLM request timeout in milliseconds. Some providers/models (for example DeepSeek)
# may need 90-120s for complex workflow nodes.
LLM_TIMEOUT=120000

# ------- Execution Engine -------
# Max request body size for JSON API calls (chat debug sends base64 images inline)
BODY_LIMIT=50mb
# Max execution time for a single Code node (ms)
CODE_NODE_TIMEOUT=5000
# Max execution time for a single HTTP node (ms)
HTTP_NODE_TIMEOUT=15000
# Max nodes allowed per workflow run (safety guard)
MAX_NODES_PER_RUN=100
# How many independent nodes of the same wave may run in parallel
MAX_PARALLEL_NODES=4
# How many queued runs may execute at the same time
MAX_CONCURRENT_RUNS=4

# ------- Sub-workflows & loops -------
# Max nesting depth for sub-workflow calls (recursion guard)
MAX_SUBFLOW_DEPTH=3
# Max items a single loop node may iterate over
MAX_LOOP_ITEMS=50
# Max parallel iterations inside one loop node
MAX_LOOP_CONCURRENCY=4

# ------- Triggers -------
# Set to false to stop the in-process cron scheduler (webhooks stay available).
SCHEDULER_ENABLED=true
# Max webhook calls per token per minute (0 disables the limiter)
WEBHOOK_RATE_LIMIT=60

# ------- Statistics -------
# Upper bound on execution rows scanned when building the dashboard
STATS_MAX_ROWS=20000
