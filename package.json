{
  "name": "zcl-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Developer-first AI workflow orchestration platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start:prod -w server",
    "deploy": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "deploy:fast": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1 -SkipBuild"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
